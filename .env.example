# Upstream Ollama endpoint (use http://ollama:11434 inside Docker Compose)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Describe your specific AIB/cooler edition if not auto-detected via PCI Subsystem ID
# Example: GPU_HARDWARE_NOTE="ASUS Noctua Edition (4.3-slot beige-and-brown heatsink, dual NF-A12x25 fans)"
GPU_HARDWARE_NOTE=